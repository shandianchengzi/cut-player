{
  "name": "cut-player",
  "version": "1.4.0",
  "description": "Windows video timestamp notebook",
  "author": "shandianchengzi",
  "license": "MIT",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "ffmpeg-static": "5.3.0",
    "playwright-core": "^1.63.0"
  },
  "build": {
    "appId": "io.github.shandianchengzi.cutplayer",
    "productName": "Cut Player",
    "files": [
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Cut-Player-${version}-${arch}-Setup.${ext}"
    },
    "publish": null,
    "portable": {
      "artifactName": "Cut-Player-${version}-${arch}-Portable.${ext}"
    },
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/LICENSE",
        "to": "ffmpeg/LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "ffmpeg/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "ffmpeg/FFmpeg-LICENSE"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "ffmpeg/FFmpeg-README"
      },
      {
        "from": "node_modules/ffmpeg-static/ffprobe.exe",
        "to": "ffmpeg/ffprobe.exe"
      }
    ]
  }
}
