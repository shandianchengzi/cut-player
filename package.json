{
  "name": "cut-player",
  "version": "1.5.12",
  "description": "Windows video timestamp notebook",
  "author": "shandianchengzi",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/check-license.cjs && node --test",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "ffmpeg-static": "5.3.0",
    "playwright-core": "^1.63.0"
  },
  "build": {
    "appId": "io.github.shandianchengzi.cutplayer",
    "productName": "Cut Player",
    "files": [
      "app/**/*",
      "package.json",
      "!node_modules/**/*.map",
      "LICENSE",
      "LICENSE-NOTICE.md",
      "COMMERCIAL-LICENSE.md"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Cut-Player-${version}-${arch}-Setup.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "shandianchengzi",
      "repo": "cut-player"
    },
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg/ffmpeg.exe"
      },
      {
        "from": "node_modules/ffmpeg-static/LICENSE",
        "to": "ffmpeg/LICENSE"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "ffmpeg/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "ffmpeg/FFmpeg-LICENSE"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.README",
        "to": "ffmpeg/FFmpeg-README"
      },
      {
        "from": "node_modules/ffmpeg-static/ffprobe.exe",
        "to": "ffmpeg/ffprobe.exe"
      },
      {
        "from": "LICENSE",
        "to": "licensing/LICENSE"
      },
      {
        "from": "LICENSE-NOTICE.md",
        "to": "licensing/LICENSE-NOTICE.md"
      },
      {
        "from": "COMMERCIAL-LICENSE.md",
        "to": "licensing/COMMERCIAL-LICENSE.md"
      }
    ],
    "compression": "maximum"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
